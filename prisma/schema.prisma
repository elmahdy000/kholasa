generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  EDITOR
  ASSISTANT
  ADMIN
  SUPER_ADMIN
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  ESSAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PublishStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum QuestionOrigin {
  OFFICIAL_TEXTBOOK
  OFFICIAL_TEXTBOOK_ADAPTED
  OFFICIAL_CLASSROOM_ASSESSMENT
  OFFICIAL_HOME_ASSESSMENT
  OFFICIAL_WEEKLY_ASSESSMENT
  OFFICIAL_ASSESSMENTS_ADAPTED
  KHOLASA_ORIGINAL
}

enum ExamMode {
  PRACTICE
  EXAM
}

enum SchoolCategory {
  ARABIC
  LANGUAGES
}

enum StudyMode {
  ONLINE
  OFFLINE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PENDING_VERIFICATION
  EXPIRED
}

enum NotificationType {
  ANNOUNCEMENT
  SYSTEM
  DAILY_EXAM
  MISTAKE_REMINDER
  COURSE_UPDATE
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  phone          String?        @unique
  password       String?
  loginCode      String?        @unique
  role           Role           @default(STUDENT)
  avatar         String?
  gradeId        String?
  systemId       String?
  trackId        String?
  schoolCategory SchoolCategory @default(ARABIC)
  maxDevices            Int                @default(1)
  boundDevices          String[]           @default([])
  isActive              Boolean            @default(true)
  studyMode             StudyMode          @default(ONLINE)
  centerName            String?
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  paymentReceiptUrl     String?
  paymentSenderPhone    String?
  paymentReference      String?
  paymentUploadedAt     DateTime?
  subscriptionExpiresAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  grade           Grade?             @relation(fields: [gradeId], references: [id])
  system          EducationalSystem? @relation(fields: [systemId], references: [id])
  track           AcademicTrack?     @relation(fields: [trackId], references: [id], onDelete: SetNull)
  accounts        Account[]
  sessions        Session[]
  progress        StudentProgress[]
  attempts        ExamAttempt[]
  mistakes        MistakeReview[]
  bookmarks            Bookmark[]
  auditLogs            AuditLog[]
  createdExams         Exam[]             @relation("ExamCreator")
  dailyChallenges      DailyChallenge[]
  notificationsRead    NotificationRead[]
  pushSubscriptions    PushSubscription[]
  createdAnnouncements Announcement[]           @relation("AnnouncementCreator")
  questionAttempts     QuestionAttempt[]
  sectionProgress      StudentSectionProgress[]
  authoredVersions     LessonContentVersion[]   @relation("LessonVersionAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  deviceId     String?
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model EducationalSystem {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  grades   Grade[]
  subjects Subject[]
  users    User[]
}

model AcademicYear {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)
}

model Grade {
  id       String @id @default(cuid())
  name     String
  code     String
  systemId String
  order    Int    @default(0)

  system   EducationalSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  tracks   AcademicTrack[]
  subjects Subject[]
  users    User[]

  @@unique([systemId, code])
}

model AcademicTrack {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  code          String
  gradeId       String
  categoryScope String?  @default("BOTH")
  isActive      Boolean  @default(true)
  order         Int      @default(0)

  grade    Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subjects Subject[]
  users    User[]

  @@unique([gradeId, code])
}

model Subject {
  id                  String         @id @default(cuid())
  name                String
  code                String
  icon                String?
  color               String?
  description         String?
  systemId            String
  gradeId             String
  trackId             String?
  schoolCategory      SchoolCategory @default(ARABIC)
  isCommonCategory    Boolean        @default(false)
  isUnderConstruction Boolean        @default(false)
  learningEngine      String         @default("STANDARD")
  isElective          Boolean        @default(false)
  electiveGroup       String?
  order               Int            @default(0)
  isPublished         Boolean        @default(true)

  system        EducationalSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  grade         Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  track         AcademicTrack?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  units         Unit[]
  questions     Question[]
  exams         Exam[]
  importBatches ImportBatch[]

  @@unique([gradeId, schoolCategory, code])
  @@index([systemId, gradeId, schoolCategory])
}

model Unit {
  id          String  @id @default(cuid())
  title       String
  order       Int     @default(0)
  description String?
  subjectId   String
  isPublished Boolean @default(true)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  questions Question[]

  @@index([subjectId, order])
}

model Lesson {
  id              String  @id @default(cuid())
  title           String
  order           Int     @default(0)
  unitId          String
  durationMinutes Int     @default(15)
  isPublished     Boolean @default(true)
  isTrial         Boolean @default(false)
  viewsCount      Int     @default(0)

  unit      Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  content   LessonContent?
  summary   LessonSummary?
  mindMap   MindMap?
  sections  LessonSection[]
  questions QuestionLesson[]
  progress        StudentProgress[]
  sectionProgress StudentSectionProgress[]
  versions        LessonContentVersion[]
  bookmarks       Bookmark[]

  @@index([unitId, order])
}

model LessonSection {
  id       String @id @default(cuid())
  lessonId String
  title    String
  anchorId String
  order    Int    @default(0)

  lesson       Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  explanations QuestionExplanation[]

  @@unique([lessonId, anchorId])
}

model LessonContent {
  id             String   @id @default(cuid())
  lessonId       String   @unique
  body           String   @db.Text
  videoUrl       String?
  audioUrl       String?
  pdfUrl         String?
  objectives     String[] @default([])
  structuredData Json?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonContentVersion {
  id               String        @id @default(cuid())
  lessonId         String
  versionNumber    Int
  status           PublishStatus @default(DRAFT)
  body             String        @db.Text
  objectives       String[]      @default([])
  structuredData   Json
  validationReport Json?
  notes            String?       @db.Text
  createdById      String?
  createdAt        DateTime      @default(now())
  publishedAt      DateTime?

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("LessonVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([lessonId, versionNumber])
  @@index([lessonId, status])
}

model LessonSummary {
  id             String   @id @default(cuid())
  lessonId       String   @unique
  pdfUrl         String?
  images         String[] @default([])
  keyConcepts    Json     @default("[]")
  definitions    Json     @default("[]")
  formulas       Json     @default("[]")
  comparisons    Json     @default("[]")
  examTips       Json     @default("[]")
  commonMistakes Json     @default("[]")
  checklist      Json     @default("[]")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model MindMap {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  title       String
  images      String[] @default([])
  description String?
  nodes       Json     @default("[]")
  edges       Json     @default("[]")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Question {
  id             String         @id @default(cuid())
  statement      String         @db.Text
  translation    String?        @db.Text
  type           QuestionType   @default(MCQ)
  difficulty     Difficulty     @default(MEDIUM)
  status         PublishStatus  @default(PUBLISHED)
  subjectId      String
  unitId         String?
  schoolCategory SchoolCategory @default(ARABIC)
  imageUrl         String?
  batchId          String?
  externalKey      String?
  origin           QuestionOrigin?
  skillCategory    String?
  sourceReferences Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  subject        Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit           Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  batch          ImportBatch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  options        QuestionOption[]
  lessons        QuestionLesson[]
  explanation    QuestionExplanation?
  rubric         EssayRubric?
  examQuestions  ExamQuestion[]
  studentAnswers StudentAnswer[]
  mistakes         MistakeReview[]
  bookmarks        Bookmark[]
  questionAttempts QuestionAttempt[]

  @@unique([subjectId, externalKey])
  @@index([subjectId, status, type, difficulty, schoolCategory])
  @@index([subjectId, origin])
  @@index([unitId])
  @@index([batchId])
}

model ImportBatch {
  id             String         @id @default(cuid())
  fileName       String
  fileType       String         // DOCX, PDF, MANUAL
  questionType   QuestionType   @default(MCQ)
  difficulty     Difficulty?
  schoolCategory SchoolCategory @default(ARABIC)
  gradeId        String
  subjectId      String
  unitId         String?
  lessonId       String?
  trackId        String?
  importedCount  Int            @default(0)
  createdAt      DateTime       @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([subjectId, schoolCategory])
  @@index([gradeId, schoolCategory])
}

model QuestionOption {
  id          String  @id @default(cuid())
  questionId  String
  text        String
  translation String? @db.Text
  isCorrect   Boolean @default(false)
  order       Int     @default(0)
  explanation String? @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionLesson {
  id         String @id @default(cuid())
  questionId String
  lessonId   String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([questionId, lessonId])
  @@index([lessonId])
}

model QuestionExplanation {
  id            String  @id @default(cuid())
  questionId    String  @unique
  concept       String
  correctReason String  @db.Text
  examTrick     String? @db.Text
  origin        String?
  sectionId     String?

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section  LessonSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
}

model EssayRubric {
  id          String @id @default(cuid())
  questionId  String @unique
  modelAnswer String @db.Text
  modelAnswerTranslation String? @db.Text
  criteria    Json   @default("[]")
  maxScore    Int    @default(10)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Exam {
  id              String         @id @default(cuid())
  title           String
  description     String?
  subjectId       String
  schoolCategory  SchoolCategory @default(ARABIC)
  durationMinutes Int            @default(30)
  isPractice      Boolean        @default(false)
  /// true for student-generated custom exams (builder / mistakes / daily). Hidden from the admin list.
  isCustom        Boolean        @default(false)
  startsAt        DateTime?
  endsAt          DateTime?
  isPublished     Boolean        @default(true)
  scopeDetails    Json?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([subjectId, schoolCategory])
  @@index([isCustom, createdById])
  @@index([startsAt, endsAt, isPublished])
}

model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  order      Int    @default(0)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
}

model ExamAttempt {
  id               String    @id @default(cuid())
  userId           String
  examId           String?
  title            String
  mode             ExamMode  @default(PRACTICE)
  totalQuestions   Int       @default(0)
  score            Float     @default(0)
  percentage       Float     @default(0)
  timeSpentSeconds Int       @default(0)
  isCompleted      Boolean   @default(false)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam?           @relation(fields: [examId], references: [id], onDelete: SetNull)
  answers StudentAnswer[]

  @@index([userId, isCompleted, completedAt])
  @@index([examId])
}

model StudentAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  essayText        String?  @db.Text
  isCorrect        Boolean?
  score            Float?
  timeSpentSeconds Int      @default(0)

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model QuestionAttempt {
  id               String   @id @default(cuid())
  userId           String
  questionId       String
  selectedOptionId String?
  essayText        String?  @db.Text
  isCorrect        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, isCorrect])
  @@index([questionId])
}

model StudentProgress {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  isCompleted     Boolean  @default(false)
  progressPercent Int      @default(0)
  lastAccessedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model StudentSectionProgress {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  sectionAnchorId String
  stageId         String
  isCompleted     Boolean  @default(false)
  lastVisitedAt   DateTime @default(now())
  state           Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, sectionAnchorId])
  @@index([userId, lessonId])
}

model MistakeReview {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  wrongCount    Int      @default(1)
  isResolved    Boolean  @default(false)
  lastAttemptAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, isResolved])
}

/// Exactly one of lessonId / questionId is set (enforced in BookmarkService).
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String?
  questionId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@unique([userId, questionId])
}

/// Server-issued daily check-in question set; one per user per calendar day (Africa/Cairo).
model DailyChallenge {
  id          String    @id @default(cuid())
  userId      String
  day         String // YYYY-MM-DD
  questionIds String[]
  attemptId   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resource, resourceId])
}

model Announcement {
  id                   String           @id @default(cuid())
  title                String
  message              String           @db.Text
  type                 NotificationType @default(ANNOUNCEMENT)
  targetGradeId        String?
  targetSchoolCategory SchoolCategory?
  link                 String?
  isUrgent             Boolean          @default(false)
  createdById          String?
  createdAt            DateTime         @default(now())
  expiresAt            DateTime?

  createdBy            User?              @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reads                NotificationRead[]

  @@index([createdAt])
  @@index([targetGradeId, targetSchoolCategory])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  announcementId String
  readAt         DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
