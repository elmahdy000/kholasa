# PostgreSQL connection string (docker compose maps host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kholasa?schema=public"

# docker-compose database credentials (optional, defaults shown)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=kholasa

# Public base URL of the app (optional)
# APP_URL="http://localhost:3000"

# OTP delivery: "console" (logs the code, dev only) or "webhook"
OTP_DELIVERY="console"
# Required when OTP_DELIVERY=webhook
# OTP_WEBHOOK_URL=""
# Echo OTP in API responses. Dev only, never enable in production.
OTP_DEV_ECHO="false"

# Password for the seeded admin account (used by npm run db:seed)
# REQUIRED: the seed refuses to run without it (min 8 characters).
# SEED_ADMIN_PASSWORD=""

# Optional password for the seeded demo student account.
# If omitted, a random unusable password is generated.
# SEED_STUDENT_PASSWORD=""

# Directory for uploaded files
UPLOAD_DIR="storage/uploads"
